---
interface Props {
  items: Array<{ label: string; href?: string }>;
}

const { items } = Astro.props;

const siteUrl = 'https://thefiftystandard.com';
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': items.map((item, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': item.label,
    ...(item.href ? { 'item': `${siteUrl}${item.href}` } : {}),
  })),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumbs">
  <ol class="breadcrumbs__list">
    {items.map((item, index) => (
      <li class="breadcrumbs__item">
        {item.href ? (
          <a href={item.href} class="breadcrumbs__link">{item.label}</a>
        ) : (
          <span class="breadcrumbs__current" aria-current="page">{item.label}</span>
        )}
        {index < items.length - 1 && <span class="breadcrumbs__separator">/</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<style>
  .breadcrumbs {
    margin-bottom: 24px;
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .breadcrumbs__link {
    color: var(--light-gray);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .breadcrumbs__link:hover {
    color: var(--charcoal);
  }

  .breadcrumbs__current {
    color: var(--olive);
  }

  .breadcrumbs__separator {
    color: var(--light-gray);
    margin: 0 8px;
  }
</style>
