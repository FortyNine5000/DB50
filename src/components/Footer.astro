---
import EmailCapture from './EmailCapture.astro';
import { footerNav } from '../data/navigation';
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__col">
      <span class="footer__brand">THE FIFTY STANDARD</span>
      <span class="footer__tagline">The pair. The work. The standard.</span>
    </div>
    <div class="footer__col footer__col--center">
      <nav class="footer__nav" aria-label="Footer navigation">
        {footerNav.map((item) => (
          <a href={item.href} class="footer__nav-link">{item.label}</a>
        ))}
      </nav>
      <a href="https://instagram.com/thefiftystandard" class="footer__link" target="_blank" rel="noopener">@thefiftystandard</a>
    </div>
    <div class="footer__col footer__col--right">
      <span class="footer__copyright">&copy; 2026 The Fifty Standard</span>
    </div>
  </div>
  <div class="footer__email container">
    <EmailCapture
      variant="footer"
      caption="Get notified when new editions and the printed field manual drop."
    />
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 40px 0 32px;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 24px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer__col--center {
    text-align: center;
    align-items: center;
    gap: 12px;
  }

  .footer__col--right {
    text-align: right;
  }

  .footer__brand {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--light-gray);
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 13px;
    color: var(--light-gray);
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    justify-content: center;
  }

  .footer__nav-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--light-gray);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__nav-link:hover {
    color: var(--charcoal);
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--light-gray);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__link:hover {
    color: var(--charcoal);
    text-decoration: underline;
  }

  .footer__copyright {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--light-gray);
  }

  .footer__email {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (max-width: 768px) {
    .footer__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 16px;
    }

    .footer__col--center,
    .footer__col--right {
      text-align: center;
    }

    .footer__col--center {
      align-items: center;
    }
  }
</style>
