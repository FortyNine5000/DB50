---
import { homepageFaqs } from '../data/faqs';
import type { FAQ } from '../data/faqs';

interface Props {
  faqs?: FAQ[];
  showIntro?: boolean;
}

const {
  faqs = homepageFaqs,
  showIntro = true,
} = Astro.props;
---

<section class="faq section section--secondary reveal">
  <div class="container">
    {showIntro && (
      <p class="faq__intro">This is not a random collection of workouts. Not an app. Not a subscription. Not a 90-day body transformation promise. It's 30 structured sessions with a finish line.</p>
    )}
    <span class="section-label">QUESTIONS</span>
    <div class="faq__list">
      {faqs.map((faq) => (
        <details class="faq__item">
          <summary class="faq__question">{faq.question}</summary>
          <div class="faq__answer-wrap">
            <p class="faq__answer">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__intro {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--warm-gray);
    max-width: var(--text-width);
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .faq__list {
    max-width: 640px;
  }

  .faq__item {
    border-bottom: 1px solid var(--border);
  }

  .faq__question {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: var(--charcoal);
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question::after {
    content: '+';
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 400;
    color: var(--light-gray);
    flex-shrink: 0;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  details[open] .faq__question::after {
    transform: rotate(45deg);
    color: var(--olive);
  }

  .faq__answer-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
    overflow: hidden;
  }

  details[open] .faq__answer-wrap {
    grid-template-rows: 1fr;
  }

  .faq__answer-wrap > .faq__answer {
    min-height: 0;
    overflow: hidden;
  }

  .faq__answer {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: var(--warm-gray);
    padding-bottom: 20px;
    max-width: var(--text-width);
  }
</style>
