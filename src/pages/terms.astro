---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms of Service — The Fifty Standard"
  description="Terms of service for The Fifty Standard. Usage terms for our digital and printed products."
  canonicalPath="/terms"
  noindex={true}
>
  <Nav />
  <main>
    <PageHero headline="Terms of Service" />
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Terms of Service' },
      ]} />
    </div>

    <section class="legal section">
      <div class="container">
        <div class="legal__content">
          <p class="legal__updated">Last updated: March 2026</p>

          <h2>Agreement</h2>
          <p>By purchasing or using The Fifty Standard products, you agree to these terms. If you do not agree, do not purchase or use our products.</p>

          <h2>Products</h2>
          <p>The Fifty Standard sells digital training programs (PDF format) and printed field manuals. Digital products are delivered electronically after purchase. Printed products are shipped via third-party fulfillment.</p>

          <h2>License</h2>
          <p>When you purchase a digital product, you receive a personal, non-transferable license to use it. You may not redistribute, resell, or share purchased products. You may print copies for your own personal use.</p>

          <h2>Disclaimer</h2>
          <p>The Fifty Standard provides training programs for informational and educational purposes. Consult a qualified healthcare provider before beginning any exercise program. You assume all risk associated with using our training programs. We are not responsible for injuries or health issues that may result from following our programs.</p>

          <h2>Intellectual Property</h2>
          <p>All content, design, and programming within The Fifty Standard products is protected by copyright. The brand name, logo, and associated marks are the property of The Fifty Standard.</p>

          <h2>Limitation of Liability</h2>
          <p>The Fifty Standard's total liability for any claim arising from use of our products is limited to the amount you paid for the product. We are not liable for indirect, incidental, or consequential damages.</p>

          <h2>Modifications</h2>
          <p>We reserve the right to update these terms at any time. Continued use of our products after changes constitutes acceptance of the updated terms.</p>

          <h2>Contact</h2>
          <p>Questions about these terms? Email <a href="mailto:hello@thefiftystandard.com">hello@thefiftystandard.com</a>.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .legal__content {
    max-width: 640px;
  }

  .legal__updated {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--light-gray);
    letter-spacing: 0.04em;
    margin-bottom: 32px;
  }

  .legal__content h2 {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .legal__content p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--warm-gray);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .legal__content a {
    color: var(--rust);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .legal__content a:hover {
    border-bottom-color: var(--rust);
  }
</style>
