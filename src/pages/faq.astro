---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import FAQSchema from '../components/FAQSchema.astro';
import CTABanner from '../components/CTABanner.astro';
import Footer from '../components/Footer.astro';
import { allFaqs } from '../data/faqs';
---

<Layout
  title="FAQ — The Fifty Standard"
  description="Common questions about The Fifty Standard: session length, equipment needed, difficulty, format, and guarantee."
  canonicalPath="/faq"
>
  <Nav />
  <main>
    <PageHero
      label="FAQ"
      headline="Frequently asked questions."
    />
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'FAQ' },
      ]} />
    </div>
    <FAQ faqs={allFaqs} showIntro={false} />
    <section class="faq-cta section reveal">
      <div class="container">
        <CTABanner
          headline="READY TO START?"
          subline="30 sessions. 4 weeks. One pair of dumbbells."
          showEmailCapture={true}
          emailTag="faq-page"
        />
      </div>
    </section>
  </main>
  <FAQSchema faqs={allFaqs} />
  <Footer />
</Layout>
