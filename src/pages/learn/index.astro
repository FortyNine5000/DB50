---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CTABanner from '../../components/CTABanner.astro';
import Footer from '../../components/Footer.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());
---

<Layout
  title="Learn — The Fifty Standard"
  description="Training insights, equipment guides, and the thinking behind The Fifty Standard. Built for people who train at home with minimal equipment."
  canonicalPath="/learn"
>
  <Nav />
  <main>
    <PageHero
      label="LEARN"
      headline="Training with less. Training harder."
      subline="Articles on home training, dumbbell programming, and the philosophy behind The Fifty Standard."
    />
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Learn' },
      ]} />
    </div>

    <section class="learn-list section reveal">
      <div class="container">
        {articles.length > 0 ? (
          <div class="learn-list__grid">
            {articles.map((article) => (
              <ArticleCard
                title={article.data.title}
                slug={article.id}
                description={article.data.description}
                readingTime={article.data.readingTime}
                publishedDate={article.data.publishedDate}
              />
            ))}
          </div>
        ) : (
          <p class="text-body">Articles are coming soon.</p>
        )}
        <div style="margin-top: 48px;">
          <CTABanner
            headline="STAY UPDATED"
            subline="New articles and training content delivered to your inbox."
            showEmailCapture={true}
            emailTag="learn-page"
            variant="compact"
          />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .learn-list__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }
</style>
