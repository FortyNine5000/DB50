---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Privacy Policy — The Fifty Standard"
  description="Privacy policy for The Fifty Standard. How we collect, use, and protect your information."
  canonicalPath="/privacy"
  noindex={true}
>
  <Nav />
  <main>
    <PageHero headline="Privacy Policy" />
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Privacy Policy' },
      ]} />
    </div>

    <section class="legal section">
      <div class="container">
        <div class="legal__content">
          <p class="legal__updated">Last updated: March 2026</p>

          <h2>Overview</h2>
          <p>The Fifty Standard ("we," "us," or "our") respects your privacy. This policy explains what information we collect, how we use it, and your rights regarding that information.</p>

          <h2>Information We Collect</h2>
          <h3>Email Address</h3>
          <p>When you sign up for notifications or purchase a product, we collect your email address. Email subscriptions are managed through Buttondown. We use your email only to send product announcements, purchase confirmations, and delivery updates.</p>

          <h3>Payment Information</h3>
          <p>Payment processing is handled by third-party providers (e.g., Stripe, Lulu Direct). We do not store credit card numbers or payment details on our servers.</p>

          <h3>Analytics</h3>
          <p>We may use privacy-respecting analytics to understand how visitors use our site. We do not sell or share personal data with third parties for advertising purposes.</p>

          <h2>How We Use Your Information</h2>
          <ul>
            <li>To deliver purchased products</li>
            <li>To send launch and product update notifications (if you opted in)</li>
            <li>To respond to support inquiries</li>
            <li>To improve our website and products</li>
          </ul>

          <h2>Data Sharing</h2>
          <p>We do not sell your personal information. We share data only with service providers necessary to operate our business (email delivery, payment processing, print fulfillment).</p>

          <h2>Your Rights</h2>
          <p>You may unsubscribe from email notifications at any time using the link in any email. To request deletion of your data, contact us at <a href="mailto:hello@thefiftystandard.com">hello@thefiftystandard.com</a>.</p>

          <h2>Cookies</h2>
          <p>Our site uses minimal cookies necessary for basic functionality. We do not use advertising or tracking cookies.</p>

          <h2>Contact</h2>
          <p>Questions about this policy? Email <a href="mailto:hello@thefiftystandard.com">hello@thefiftystandard.com</a>.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .legal__content {
    max-width: 640px;
  }

  .legal__updated {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--light-gray);
    letter-spacing: 0.04em;
    margin-bottom: 32px;
  }

  .legal__content h2 {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .legal__content h3 {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--olive);
    margin-top: 24px;
    margin-bottom: 8px;
  }

  .legal__content p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--warm-gray);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .legal__content ul {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--warm-gray);
    line-height: 1.65;
    margin-bottom: 16px;
    padding-left: 20px;
  }

  .legal__content li {
    margin-bottom: 4px;
  }

  .legal__content li::marker {
    color: var(--olive);
  }

  .legal__content a {
    color: var(--rust);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .legal__content a:hover {
    border-bottom-color: var(--rust);
  }
</style>
