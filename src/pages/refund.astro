---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Refund Policy — The Fifty Standard"
  description="30-day money-back guarantee on all Fifty Standard products. No questions asked."
  canonicalPath="/refund"
  noindex={true}
>
  <Nav />
  <main>
    <PageHero headline="Refund Policy" />
    <div class="container">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Refund Policy' },
      ]} />
    </div>

    <section class="legal section">
      <div class="container">
        <div class="legal__content">
          <p class="legal__updated">Last updated: March 2026</p>

          <h2>30-Day Money-Back Guarantee</h2>
          <p>All Fifty Standard products come with a 30-day money-back guarantee. If you're not satisfied for any reason, contact us within 30 days of purchase and we'll issue a full refund. No questions asked.</p>

          <h2>Digital Products</h2>
          <p>Digital products (PDF training programs) are refunded to your original payment method. Refunds are typically processed within 5–7 business days.</p>

          <h2>Printed Products</h2>
          <p>For printed field manuals, you may request a refund within 30 days of delivery. If the product arrived damaged, we'll replace it at no cost or issue a full refund. We do not require you to return the physical product.</p>

          <h2>How to Request a Refund</h2>
          <p>Email <a href="mailto:hello@thefiftystandard.com">hello@thefiftystandard.com</a> with your order number and we'll take care of it. That's it.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .legal__content {
    max-width: 640px;
  }

  .legal__updated {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--light-gray);
    letter-spacing: 0.04em;
    margin-bottom: 32px;
  }

  .legal__content h2 {
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    margin-top: 40px;
    margin-bottom: 12px;
  }

  .legal__content p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--warm-gray);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .legal__content a {
    color: var(--rust);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .legal__content a:hover {
    border-bottom-color: var(--rust);
  }
</style>
